# Copy to .env and adjust as needed for local development.
# These are local-only development defaults, not real credentials.

APP_ENV=development

# Must use the asyncpg driver (postgresql+asyncpg://...), not plain
# postgresql:// — see docs/ARCHITECTURE.md §5.
DATABASE_URL=postgresql+asyncpg://jobgoblin:jobgoblin@localhost:5432/jobgoblin

# Seconds before a database connectivity check (used by /ready) gives up.
DATABASE_CONNECT_TIMEOUT_SECONDS=3.0

# Disposable database for automated tests ONLY (backend/tests/) — never the
# same database as DATABASE_URL above. The database name must contain "test";
# backend/tests/conftest.py refuses to run against anything else, including
# the ordinary `jobgoblin` development database. See README.md's "Dedicated
# test database" section for one-time setup.
TEST_DATABASE_URL=postgresql+asyncpg://jobgoblin:jobgoblin@localhost:5432/jobgoblin_test
