      "record_id": "location-ascii-only-casefold--transform-none--target-location--boundary-state_token--variant-base",
      "kind": "base",
      "parser": "location",
      "guard_ref": "location/g06-ascii-only-casefold",
      "is_primary_witness": true,
      "historical_defect_ref": "071d8dc finding 6",
      "target": {"input_field": "location", "semantic_form": "city_state_pair", "boundary": "state_token"},
      "original_input": {"location": "Austin, Wİ"},
      "transform": {"name": "none", "parameters": {}},
      "expected_transformed_input": {"location": "Austin, Wİ"},
      "expected_output": {
        "city": {"value": null, "provenance": "unavailable"},
        "state": {"value": null, "provenance": "unavailable"},
        "country": {"value": null, "provenance": "unavailable"},
        "postal_code": {"value": null, "provenance": "unavailable"}
      },
      "rationale": "U+0130 (Turkish dotted capital I) is not an ASCII 'I' and not an NFKC compatibility fold of one. With re.ASCII on the state-token grammar, 'W\\u0130' never fullmatches the Wisconsin alternative at all, so the whole location fails to match any production. Empirically verified directly: re.compile(state_token, re.IGNORECASE|re.ASCII).fullmatch('W\\u0130') is None."
    },
